---
import SiteHead from '../components/SiteHead.astro'
import SiteFoot from '../components/SiteFoot.astro'
import SiteScrollRod from '../components/SiteScrollRod.astro'
import SiteInkIntro from '../components/SiteInkIntro.astro'
import CopyEmail from '../components/CopyEmail.astro'
import MotionPack from '../components/MotionPack.astro'
import { ClientRouter } from 'astro:transitions'

import '../styles/global.scss'

interface Props {
  title: string
  description?: string
  bodyClass?: string
  /** 默认收录；账号 / 管理 / 私信 / 班级等私密页传 noindex */
  robots?: string
}

const {
  title,
  description = '个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。',
  bodyClass,
  robots = 'index, follow',
} = Astro.props

const isSubpage = Astro.url.pathname !== '/'
const ogImage = '/images/about-cover.svg'
const ogUrl = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<!doctype html>
<html
  lang="zh-CN"
  class:list={[
    !isSubpage && 'is-scroll-blocked',
    !isSubpage && 'is-intro-active',
  ]}
>
  <head>
    <meta charset="utf-8" />

    <!-- FOUC gate: first paint is blank paper, never unstyled markup -->
    <style is:inline>
      html {
        background-color: #f4ead8;
      }
      html.theme-contrasted {
        background-color: #0e1412;
      }
      html:not(.is-css-ready) body {
        visibility: hidden;
        opacity: 0;
      }
    </style>
    <script is:inline>
      (function () {
        var root = document.documentElement
        var done = false
        var domReady = document.readyState !== 'loading'

        function reveal() {
          if (done) return
          done = true
          root.classList.add('is-css-ready')
        }

        function siteLinks() {
          return Array.prototype.filter.call(
            document.querySelectorAll('link[rel="stylesheet"]'),
            function (link) {
              return (link.getAttribute('href') || '').indexOf('/_astro/') !== -1
            }
          )
        }

        function allComplete(links) {
          if (!links.length) return false
          for (var i = 0; i < links.length; i++) {
            try {
              if (!links[i].sheet) return false
            } catch (e) {
              return false
            }
          }
          return true
        }

        function tryReveal() {
          if (!domReady) return
          if (allComplete(siteLinks())) reveal()
        }

        function bind() {
          var links = siteLinks()
          for (var i = 0; i < links.length; i++) {
            if (links[i].getAttribute('data-fouc-armed') === '1') continue
            links[i].setAttribute('data-fouc-armed', '1')
            links[i].addEventListener('load', tryReveal)
            links[i].addEventListener('error', tryReveal)
          }
          tryReveal()
        }

        var mo = new MutationObserver(bind)
        mo.observe(root, { childList: true, subtree: true })
        bind()

        document.addEventListener('DOMContentLoaded', function () {
          domReady = true
          bind()
          try {
            mo.disconnect()
          } catch (e) {}
        })

        // Safety: never stay blank forever if CSS fails
        setTimeout(reveal, 3500)
      })()
    </script>
    <noscript>
      <style>
        /* No JS: keep content hidden so the unstyled shell never paints.
           Next build's site CSS also lifts this gate once it applies. */
      </style>
    </noscript>

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <meta name="robots" content={robots} />

    <link rel="manifest" href="/icons/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="陈润森 · Chen Runsen"
      href="/rss.xml"
    />
    <link
      rel="icon"
      type="image/png"
      href="/icons/favicon-48x48.png"
      sizes="48x48"
    />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="陈润森" />

    <meta name="theme-color" content="#f4ead8" />
    <meta name="msapplication-navbutton-color" content="#f4ead8" />
    <meta name="apple-mobile-web-app-status-bar-style" content="#f4ead8" />

    <ClientRouter />

    <!-- Apply theme before first paint; persist across ClientRouter swaps -->
    <script is:inline>
      (function () {
        var storageKey = 'site-theme'

        function apply(root) {
          if (!root) return
          // 尽早标记 JS 可用：显影类隐藏规则只挂在 html.js 下，
          // 无 JS 环境（爬虫/禁 JS/脚本被拦）内容保持直接可见
          root.classList.add('js')
          var stored = null
          try {
            stored = localStorage.getItem(storageKey)
          } catch (e) {}

          var dark =
            stored === 'dark' ||
            (stored !== 'light' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)

          root.classList.toggle('theme-contrasted', dark)
          root.dataset.theme = stored || (dark ? 'dark' : 'light')

          var color = dark ? '#0e1412' : '#f4ead8'
          var metas = root.querySelectorAll
            ? root.querySelectorAll(
                'meta[name="theme-color"], meta[name="msapplication-navbutton-color"], meta[name="apple-mobile-web-app-status-bar-style"]'
              )
            : []
          if (!metas.length && root === document.documentElement) {
            metas = document.querySelectorAll(
              'meta[name="theme-color"], meta[name="msapplication-navbutton-color"], meta[name="apple-mobile-web-app-status-bar-style"]'
            )
          }
          for (var i = 0; i < metas.length; i++) {
            metas[i].setAttribute('content', color)
          }

          try {
            root.style.backgroundColor = color
          } catch (e) {}
        }

        apply(document.documentElement)

        function unlockPreparing(root, doc) {
          if (!root) return
          try {
            window.__siteRevealed = 1
          } catch (e) {}
          root.classList.remove('is-scroll-blocked', 'is-intro-active')
          root.classList.add('is-site-ready')
          var wrap = (doc || document).querySelector('.js-site-wrapper')
          if (wrap) {
            wrap.classList.remove('is-preparing')
            wrap.style.opacity = '1'
          }
        }

        function shouldUnlockEarly() {
          try {
            if (sessionStorage.getItem('site-intro-seen') === '1') return true
          } catch (e) {}
          try {
            return window.matchMedia('(prefers-reduced-motion: reduce)').matches
          } catch (e) {}
          return false
        }

        // 看过开场 / 减少动态：尽早摘锁，避免 is-preparing 白屏
        if (shouldUnlockEarly()) {
          unlockPreparing(document.documentElement, document)
          document.addEventListener('DOMContentLoaded', function () {
            unlockPreparing(document.documentElement, document)
          })
        }

        document.addEventListener('astro:before-swap', function (event) {
          var nextDoc = event.newDocument
          var next = nextDoc.documentElement
          apply(next)
          // SPA 回首页不要带回 SSR 的开场锁；intro 只在首次硬加载播
          next.classList.remove('is-scroll-blocked', 'is-intro-active')
          var nextWrap = nextDoc.querySelector('.js-site-wrapper')
          if (nextWrap) nextWrap.classList.remove('is-preparing')
          // 换页先摘显影门，等新页 initInkReveal 再挂，避免旧门挡住新页兜底
          next.classList.remove('is-ink-ready')

          // 字体样式表是非阻塞的；已激活则换页不要退回 media=print
          var liveFonts = document.querySelector('link[data-site-fonts]')
          var nextFonts = nextDoc.querySelector('link[data-site-fonts]')
          if (liveFonts && nextFonts && liveFonts.media === 'all') {
            nextFonts.media = 'all'
          }
        })

        // 模块脚本失败时：内联超时撤掉开场锁，避免整页永远透明
        setTimeout(function () {
          var root = document.documentElement
          var wrapper = document.querySelector('.js-site-wrapper')
          if (!wrapper || !wrapper.classList.contains('is-preparing')) return
          try {
            window.__siteRevealed = 1
          } catch (e) {}
          wrapper.classList.remove('is-preparing')
          wrapper.style.opacity = '1'
          root.classList.add('is-site-ready')
          root.classList.remove('is-scroll-blocked', 'is-intro-active')
          var hero = document.querySelector('.s-hero')
          var head = document.querySelector('.site-head')
          if (hero) hero.style.opacity = '1'
          if (head) head.style.opacity = '1'
        }, 3200)
      })()
    </script>

    <noscript>
      <style>
        html.is-scroll-blocked,
        html.is-intro-active {
          overflow: auto;
        }
        .ink-intro,
        .js-intro {
          display: none !important;
        }
        .site-wrapper.is-preparing {
          opacity: 1 !important;
          pointer-events: auto;
        }
        .site-wrapper.is-preparing .site-head,
        .site-wrapper.is-preparing .s-hero,
        .s-hero {
          opacity: 1 !important;
        }
      </style>
    </noscript>

    <!-- 减少动态：不要等模块脚本才摘 is-preparing，否则首屏会白屏 -->
    <style>
      @media (prefers-reduced-motion: reduce) {
        .site-wrapper.is-preparing {
          opacity: 1 !important;
          pointer-events: auto;
        }
        .site-wrapper.is-preparing .site-head,
        .site-wrapper.is-preparing .s-hero {
          opacity: 1 !important;
        }
      }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      宋体走可变字重：200–900 每个汉字切片只下一份，不再按 200/400/700/900 各下一遍。
      media=print 让这份样式表离开关键路径，先用系统宋体出字，到齐再换。
    -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;700&family=Noto+Serif+SC:wght@200..900&display=swap"
      media="print"
      data-site-fonts
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;700&family=Noto+Serif+SC:wght@200..900&display=swap"
      />
    </noscript>

    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="陈润森" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

  </head>

  <body class:list={[isSubpage && 'is-subpage', bodyClass]}>
    <div
      class:list={[
        'site-wrapper js-site-wrapper',
        !isSubpage && 'is-preparing',
      ]}
    >
      <SiteHead />

      <slot />

      <SiteFoot />
    </div><!-- .site-wrapper -->

    {!isSubpage && <SiteInkIntro />}

    <div class="site-mount js-mount"></div>
    <div class="site-contrast-mask js-contrast-mask"></div>

    <SiteScrollRod />

    <CopyEmail />

    <MotionPack />
  </body>

  <script>
    import { watchIdleAnimations } from '../utils/idle-anim'
    import { initInkReveal } from '../motion/ink-reveal'
    import { initSealPress } from '../motion/seal-press'
    import { initLeafFlip } from '../motion/leaf-flip'
    import { initCardFold } from '../motion/card-fold'
    import { initHandscroll } from '../motion/handscroll'
    import { markReady, nextFrame, prefersReducedMotion } from '../motion/core'
    import {
      playInkIntro,
      revealSiteNow,
      hasSeenIntro,
      consumeHardLoad,
      wasRevealed,
    } from '../motion/ink-intro'

    import Lenis from 'lenis'

    import { gsap } from 'gsap'
    import { ScrollTrigger } from 'gsap/ScrollTrigger'
    gsap.registerPlugin(ScrollTrigger)

    declare global {
      interface Window {
        safeWidth: number
        safeHeight: number
        maxScrollTop: number
        scrollProgress: number
        lenis: any
        __site: any
        __siteRevealed?: number
        __siteHardLoadConsumed?: boolean
        __motionPackBound?: boolean
      }
    }

    /**
     * 研墨壳 —— 站点运行时：量尺、平滑滚动、入场、换页重绑。
     * 帧循环与视口/滚动/指针信号已交给 motion/core，这里只做壳层职责。
     */
    class Site {
      timeouts: any = {
        resizeThrottle: null,
        introSafety: null,
      }

      windowWidth: number
      windowHeight: number
      clientWidth: number
      clientHeight: number

      isScrolling: boolean = false

      lenis: any

      booted: boolean = false

      /** 离屏动画暂停器的清理函数（每次换页重绑前先清掉） */
      stopIdleAnimations: (() => void) | null = null

      /** 原创动效各模块的清理函数（每次换页重绑前先清掉） */
      stopMotion: Array<() => void> = []

      /** data-intersect 观察者（每次换页重建，旧的必须断开，否则逐页累积） */
      pageObserver: IntersectionObserver | null = null

      /** 换页监听只绑一次；HMR / 脚本重评不能再叠一份 */
      routerBound: boolean = false

      /** 当前这一页是否已经跑过 pageSetup（teardown 后清掉） */
      didPageSetup: boolean = false

      /** 成功进入 pageSetup 的次数（测「每页一遍」） */
      setupRuns: number = 0

      teardownRuns: number = 0

      lastTeardown: {
        inkReady: boolean
        didSetup: boolean
        observer: boolean
        motion: number
      } | null = null

      hasLoaded: boolean = false
      os: string = 'unknown'
      browser: string = 'unknown'

      /**
       * Constructor
       */
      constructor() {
        this.os = 'unknown'
        if (navigator.userAgent.indexOf('Win') !== -1) {
          this.os = 'windows'
        } else if (navigator.userAgent.indexOf('Android') !== -1) {
          this.os = 'android'
        } else if (navigator.userAgent.indexOf('Mac') !== -1) {
          this.os = 'mac'
        } else if (navigator.userAgent.indexOf('Linux') !== -1) {
          this.os = 'linux'
        }

        this.browser = 'unknown'
        if (navigator.userAgent.indexOf('Firefox') !== -1) {
          this.browser = 'firefox'
        } else if (navigator.userAgent.indexOf('Chrome') !== -1) {
          this.browser = 'chrome'
        } else if (navigator.userAgent.indexOf('Safari') !== -1) {
          this.browser = 'safari'
        }

        this.booted = false
        this.syncEnvironmentClasses()
        this.bindGlobalEvents()
      }

      /**
       * ClientRouter 换页会整表替换 <html> 属性，环境类必须写回。
       */
      syncEnvironmentClasses() {
        const root = document.documentElement
        root.classList.add('js', `is-${this.os}`, `is-${this.browser}`)
        if (this.hasLoaded) root.classList.add('is-loaded')
        root.classList.toggle(
          'is-subpage-ready',
          document.body.classList.contains('is-subpage')
        )
      }

      /**
       * Initialization — one-time boot（Lenis / 量尺）。
       * 不在这里跑 pageSetup：astro:page-load 每次都会调，避免首载双跑。
       */
      init() {
        if (this.booted) return
        this.booted = true

        this.initLenis()
        this.onResize()
        this.watchDocumentHeight()
      }

      /**
       * Per-page setup — 每次（含 SPA 换页后）都要执行
       */
      pageSetup() {
        if (this.didPageSetup) return
        this.didPageSetup = true
        this.setupRuns += 1

        this.syncEnvironmentClasses()

        const reducedMotion = prefersReducedMotion()
        const introSeen = hasSeenIntro()
        const hasIntro = !!document.querySelector('.js-intro')
        // 必须先消耗硬载资格，避免从内页 SPA 回首页时误播全屏森字
        const isHardLoad = consumeHardLoad()
        const alreadyRevealed =
          wasRevealed() ||
          document.documentElement.classList.contains('is-site-ready')
        const playIntro =
          !reducedMotion &&
          !introSeen &&
          hasIntro &&
          isHardLoad &&
          !alreadyRevealed

        // ClientRouter 会整表替换 <html> 属性；开场锁按本页重写
        document.documentElement.classList.toggle(
          'is-scroll-blocked',
          playIntro
        )
        document.documentElement.classList.toggle('is-intro-active', playIntro)

        this.bindPageObservers()
        this.bindIdleAnimations()
        this.initMotion()

        try {
          const stored = localStorage.getItem('site-theme')
          const dark =
            stored === 'dark' ||
            (stored !== 'light' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.classList.toggle('theme-contrasted', dark)
          document.documentElement.dataset.theme =
            stored || (dark ? 'dark' : 'light')
        } catch (e) {}

        clearTimeout(this.timeouts.introSafety)
        if (!playIntro) {
          nextFrame(() => this.forceReveal())
        } else {
          nextFrame(() => this.intro())
          // Safety net: never leave the site hidden behind a stuck intro
          this.timeouts.introSafety = setTimeout(() => this.forceReveal(), 3000)
        }

        this.onScroll()
      }

      /**
       * Bind global events — 只绑一次（构造时）
       */
      bindGlobalEvents() {
        window.addEventListener('resize', this.resizeThrottle.bind(this))
        window.addEventListener('scroll', this.onScroll.bind(this), {
          passive: true,
        })

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) gsap.ticker.sleep()
          else gsap.ticker.wake()
        })

        // Site loaded event
        if (document.readyState === 'complete') {
          this.siteLoaded()
        } else {
          window.addEventListener('load', this.siteLoaded.bind(this), {
            once: true,
          })
        }
      }

      /**
       * Bind per-page observers — 每次换页重绑（旧元素随 swap 销毁）
       */
      bindPageObservers() {
        this.pageObserver?.disconnect()

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.dispatchEvent(
                new CustomEvent('intersect', {
                  detail: { isIntersecting: entry.isIntersecting },
                })
              )

              if (entry.isIntersecting) {
                entry.target.classList.add('is-in-view')
                entry.target.classList.remove(
                  'is-out-of-view',
                  'is-out-of-view-top',
                  'is-out-of-view-bottom'
                )
              } else {
                entry.target.classList.remove('is-in-view')
                entry.target.classList.add('is-out-of-view')

                entry.target.classList.toggle(
                  'is-out-of-view-top',
                  entry.boundingClientRect.top < 0
                )
                entry.target.classList.toggle(
                  'is-out-of-view-bottom',
                  entry.boundingClientRect.top > 0
                )
              }
            })
          },
          {
            threshold: 0,
          }
        )

        document.querySelectorAll('[data-intersect]').forEach((el) => {
          observer.observe(el)
        })

        this.pageObserver = observer
      }

      /**
       * 装饰性无限动画：离屏暂停、回屏恢复。
       * 首页这类长页上同时有十几处漂移/呼吸动画，
       * 滚过之后不该继续占用每帧的合成预算。
       */
      bindIdleAnimations() {
        if (this.stopIdleAnimations) {
          this.stopIdleAnimations()
          this.stopIdleAnimations = null
        }

        if (prefersReducedMotion()) {
          return
        }

        this.stopIdleAnimations = watchIdleAnimations()
      }

      /**
       * Init lenis
       *
       * 只在平滑滚动进行时把 raf 挂上 GSAP ticker。
       * 常驻监听会让 ticker 的自动休眠失效（监听数 ≥ 2），
       * 页面静止时仍每帧空转。
       */
      initLenis() {
        if (prefersReducedMotion()) return
        if (this.lenis) return

        const lenis = new Lenis({ autoRaf: false })

        lenis.on('scroll', ScrollTrigger.update)

        let driving = false

        const needsFrame = () => !lenis.isStopped && lenis.isScrolling === 'smooth'

        const drive = (time: number) => {
          lenis.raf(time * 1000)
          if (needsFrame()) return
          gsap.ticker.remove(drive)
          driving = false
        }

        const kick = () => {
          if (driving || !needsFrame()) return
          driving = true
          // 优先于时间线渲染，滚动进度和补间落在同一帧
          gsap.ticker.add(drive, false, true)
        }

        let kickQueued = false
        lenis.on('virtual-scroll', () => {
          if (kickQueued || driving) return
          kickQueued = true
          queueMicrotask(() => {
            kickQueued = false
            kick()
          })
        })

        const scrollTo = lenis.scrollTo.bind(lenis)
        lenis.scrollTo = (target, options) => {
          scrollTo(target, options)
          kick()
        }

        window.lenis = lenis
        this.lenis = lenis
      }

      /**
       * Set loaded class
       */
      siteLoaded() {
        this.hasLoaded = true
        document.documentElement.classList.add('is-loaded')
        this.onResize()
        markReady()
      }

      /**
       * SPA 换页前：停观察者、闲动画、显影管线，摘 is-ink-ready
       */
      teardownPage() {
        this.didPageSetup = false
        clearTimeout(this.timeouts.introSafety)
        this.timeouts.introSafety = null
        this.pageObserver?.disconnect()
        this.pageObserver = null
        if (this.stopIdleAnimations) {
          try {
            this.stopIdleAnimations()
          } catch (error) {
            console.error('[site] idle-anim teardown failed:', error)
          }
          this.stopIdleAnimations = null
        }
        this.stopMotion?.forEach((stop) => {
          try {
            stop()
          } catch (error) {
            console.error('[site] motion teardown failed:', error)
          }
        })
        this.stopMotion = []
        document.documentElement.classList.remove('is-ink-ready')
        this.teardownRuns += 1
        this.lastTeardown = {
          inkReady: document.documentElement.classList.contains('is-ink-ready'),
          didSetup: this.didPageSetup,
          observer: !!this.pageObserver,
          motion: this.stopMotion.length,
        }
      }

      /**
       * 原创动效：洇墨显影 / 印章钤印 / 册页翻页 / 目录折角 / 长卷平移
       * 每次换页重建（旧元素随 swap 销毁）
       */
      initMotion() {
        this.stopMotion?.forEach((stop) => {
          try {
            stop()
          } catch (error) {
            console.error('[site] motion reset failed:', error)
          }
        })
        this.stopMotion = []
        document.documentElement.classList.remove('is-ink-ready')

        this.stopMotion = [
          initInkReveal(),
          initSealPress(),
          initLeafFlip(),
          initCardFold(),
          initHandscroll(),
        ]
      }

      /**
       * Resize throttle
       */
      resizeThrottle() {
        clearTimeout(this.timeouts.resizeThrottle)

        this.timeouts.resizeThrottle = setTimeout(() => {
          nextFrame(() => this.onResize())
        }, 200)
      }

      /**
       * Resize handler
       */
      onResize() {
        const newWidth = window.innerWidth
        let widthChanged = false
        if (this.windowWidth !== newWidth) {
          if (this.windowWidth !== undefined) {
            widthChanged = true
          }

          this.windowWidth = newWidth
          this.clientWidth = document.body.clientWidth
        }

        const newHeight = window.innerHeight
        let heightChanged = false
        if (this.windowHeight !== newHeight) {
          if (this.windowHeight !== undefined) {
            heightChanged = true
          }

          this.windowHeight = newHeight
          this.clientHeight = document.body.clientHeight
        }

        window.safeWidth = newWidth
        window.safeHeight = newHeight

        this.setScrollProgress()
      }

      /**
       * 正文被字体 / 懒图撑高后刷新行程，避免 maxScrollTop 陈旧
       */
      watchDocumentHeight() {
        if (typeof ResizeObserver !== 'function') return
        const ro = new ResizeObserver(() => this.setScrollProgress())
        ro.observe(document.documentElement)
        try {
          document.fonts?.ready?.then(() => this.setScrollProgress())
        } catch (e) {}
      }

      /**
       * Scroll handler
       */
      onScroll() {
        this.setScrollProgress()
      }

      /**
       * 滚动进度：行程用实时几何，不缓存 load 时的文档高度
       */
      setScrollProgress() {
        const max = Math.max(
          0,
          document.documentElement.scrollHeight - window.innerHeight
        )
        window.maxScrollTop = max
        window.scrollProgress = max > 0 ? window.scrollY / max : 0
      }

      /**
       * Force reveal (skip intro)
       */
      forceReveal() {
        revealSiteNow()
        this.onResize()
      }

      /**
       * Intro —— 研墨开卷（编排在 src/motion/ink-intro.ts）
       */
      intro() {
        playInkIntro().then(() => {
          nextFrame(() => this.onResize())
        })
      }
    }

    // SPA 单例：模块脚本在 ClientRouter 下只执行一次
    const site = (window.__site ||= new Site())

    if (!site.routerBound) {
      site.routerBound = true

      document.addEventListener('astro:before-swap', () => {
        site.teardownPage()
      })

      // 换页后立刻重绑，不要等 window.load；page-load 若再来会被 didPageSetup 挡住
      document.addEventListener('astro:after-swap', () => {
        site.syncEnvironmentClasses()
        site.init()
        site.pageSetup()
      })

      document.addEventListener('astro:page-load', () => {
        site.init()
        site.pageSetup()
      })

      // 首屏：astro:page-load 绑在 window.load 上，等图片会把 is-preparing 拖成白屏
      site.init()
      site.pageSetup()
    }
  </script>
</html>
