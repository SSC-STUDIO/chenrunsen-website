---
import { songs } from '../features/jay-town/songs'
import { MEDIA, thumbUrl, ZONE_LABELS } from '../features/jay-town/media'

const stops = [
  { name: '樱花街口', mood: '把第一首歌，留给春天。' },
  { name: '唱片小巷', mood: '旧唱片转动，晚风也有了节拍。' },
  { name: '晴天广场', mood: '阳光落在屋檐和路面之间。' },
  { name: '花海车站', mood: '下一班列车，开往花开的地方。' },
  { name: '七里香河堤', mood: '沿着水声，再听一遍夏天。' },
] as const
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#dcece7" />
    <meta name="description" content="沿着樱花街口、唱片小巷与七里香河堤，走进一座装着周杰伦歌曲的小镇。" />
    <meta property="og:title" content="周杰伦的樱花小镇" />
    <meta property="og:description" content="一座可以散步、看花、听歌的小镇。" />
    <title>周杰伦的樱花小镇</title>
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#song-drawer-open">跳到歌单按钮</a>
    <main class="town" id="town" aria-labelledby="town-title">
      <div class="town-poster" aria-hidden="true"></div>
      <div class="town-veil" aria-hidden="true"></div>
      <canvas class="town-canvas" id="town-canvas" aria-hidden="true"></canvas>
      <div class="town-shade" aria-hidden="true"></div>

      <header class="town-header">
        <div class="identity">
          <div class="identity__labels"><span>SAKURA</span><span>FM 2000—</span></div>
          <h1 id="town-title">周杰伦的<span>樱花小镇</span></h1>
          <p>沿着花落的方向，把歌听成一段散步。</p>
        </div>
        <div class="header-tools" role="group" aria-label="小镇工具">
          <a class="home-link" href="/" title="返回陈润森的网站" aria-label="返回陈润森的网站">← <span>返回</span></a>
          <button class="tool-button day-toggle" id="day-toggle" type="button" aria-label="切换到夜晚" title="切换到夜晚" aria-pressed="false"><span aria-hidden="true">☾</span></button>
          <button class="tool-button" id="help-open" type="button" aria-label="帮助与来源" title="帮助与来源"><span aria-hidden="true">?</span></button>
          <button class="hide-button" id="ui-hide" type="button" aria-label="隐藏界面" title="隐藏界面">隐藏界面</button>
        </div>
      </header>

      <button class="ui-restore" id="ui-restore" type="button" hidden>显示界面</button>

      <div class="scene-status" id="scene-status" role="status" aria-live="polite">
        <span class="scene-status__mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="scene-status__body">
          <strong id="scene-phase">小镇正在亮起</strong>
          <span id="scene-note">第一次打开会慢一些，之后会留在缓存里。</span>
        </span>
        <span class="scene-status__trail" id="scene-trail" aria-hidden="true"></span>
      </div>
      <div class="scene-failure" id="scene-failure" hidden>
        <p>3D 场景暂时无法显示，歌单仍可查看。</p>
        <button class="scene-failure__action" id="failure-songs" type="button">打开歌单</button>
      </div>

      <button class="stop-media" id="stop-media" type="button" aria-label="停止播放" title="停止播放" hidden>
        <span aria-hidden="true">■</span> 停止播放
      </button>

      <div class="place-stamp" aria-live="polite" aria-atomic="true">
        <span class="place-stamp__index" id="place-index">01 / 05</span>
        <strong id="place-name">樱花街口</strong>
        <span id="place-mood">把第一首歌，留给春天。</span>
      </div>

      <nav class="town-route" aria-label="小镇五站">
        {stops.map((stop, index) => (
          <button
            class:list={['town-route__stop', index === 0 && 'is-active']}
            type="button"
            data-zone={index}
            aria-label={`第 ${index + 1} 站：${stop.name}`}
            aria-current={index === 0 ? 'location' : undefined}
          >
            <span class="town-route__marker" aria-hidden="true"></span>
            <span class="town-route__number">{String(index + 1).padStart(2, '0')}</span>
            <strong>{stop.name}</strong>
          </button>
        ))}
      </nav>

      <button class="drawer-handle" id="song-drawer-open" type="button" aria-label="打开歌单" title="打开歌单" aria-controls="song-drawer" aria-expanded="false">
        <span class="drawer-handle__bar" aria-hidden="true"></span>
        <span class="drawer-handle__label">歌单 · <b>{songs.length}</b> 首</span>
      </button>

      <div class="move-pad" id="move-pad" role="group" aria-label="移动方向">
        <button class="move-pad__up" type="button" data-move-x="0" data-move-z="-1" aria-label="向前走" title="向前走">↑</button>
        <button class="move-pad__left" type="button" data-move-x="-1" data-move-z="0" aria-label="向左走" title="向左走">←</button>
        <span class="move-pad__center" aria-hidden="true">✳</span>
        <button class="move-pad__right" type="button" data-move-x="1" data-move-z="0" aria-label="向右走" title="向右走">→</button>
        <button class="move-pad__down" type="button" data-move-x="0" data-move-z="1" aria-label="向后走" title="向后走">↓</button>
      </div>

      {/* 素材导航（表层）。
        *
        * 用户要的是「表层用来做个导航，导航到各个图片」：小镇里每一件素材
        * ——六张唱片封面、一张猪、四段自己的影像——都在这里有一张缩略图，
        * 点一下就把镜头带到它跟前。缩略图直接由 `media.ts` 那张表渲染，
        * 所以「场景里摆了哪些」和「这里能导航到哪些」不可能对不上。 */}
      <div class="town-nav" id="town-nav" data-nav-open="false">
        <button class="town-nav__toggle" id="town-nav-toggle" type="button" aria-expanded="false" aria-controls="town-nav-strip">
          <span class="town-nav__toggle-icon" aria-hidden="true">▦</span>
          <span class="town-nav__toggle-label">素材 <b>{MEDIA.length}</b></span>
        </button>
        <div class="town-nav__strip" id="town-nav-strip">
          <p class="town-nav__hint">小镇里的每一样东西，点一下走过去</p>
          <ol class="town-nav__list">
            {MEDIA.map((item) => (
              <li>
                <button
                  class="town-nav__item"
                  type="button"
                  data-media-id={item.id}
                  data-media-zone={item.zone}
                  data-media-target={item.target}
                  title={`${item.title} · ${item.caption}`}
                >
                  <img class="town-nav__thumb" src={thumbUrl(item.file)} alt="" width="72" height="54" decoding="async" />
                  <span class="town-nav__text"><b>{item.title}</b><small>{item.caption}</small></span>
                  <span class="town-nav__where">0{item.target + 1} {ZONE_LABELS[item.target]}</span>
                  {item.kind === 'video' && <span class="town-nav__badge" aria-hidden="true">▶</span>}
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <aside class="song-drawer" id="song-drawer" aria-labelledby="song-drawer-title" hidden>
        <div class="drawer-head">
          <div><span class="drawer-kicker">SAKURA / MUSIC ARCHIVE</span><h2 id="song-drawer-title">小镇歌单</h2></div>
          <button class="panel-icon" id="song-drawer-close" type="button" aria-label="关闭歌单" title="关闭歌单">×</button>
        </div>
        <div class="song-filters">
          <label class="search-field"><span class="sr-only">搜索歌曲或专辑</span><span aria-hidden="true">⌕</span><input id="song-search" type="search" placeholder="搜索歌曲或专辑" autocomplete="off" /></label>
          <label class="zone-field"><span class="sr-only">按场景筛选歌曲</span><select id="song-zone-filter"><option value="all">全部场景</option>{stops.map((stop, index) => <option value={index}>{stop.name}</option>)}</select></label>
          <button class="favorites-filter" id="favorites-filter" type="button" aria-pressed="false" title="只看收藏">☆ <span>收藏</span></button>
        </div>
        <p class="song-count" id="song-count">{songs.length} 首歌曲
          <button class="source-toggle" id="song-source" type="button" title="切换 MV 来源" aria-label="切换 MV 来源"><span id="song-source-label">B站</span></button>
        </p>
        <ol class="song-list" id="song-list">
          {songs.map((song, index) => (
            <li class="song-row" data-song-id={song.id}>
              <span class="song-row__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="song-row__art" style={`--song-color: ${song.color}`} aria-hidden="true">♫</span>
              <span class="song-row__body"><strong>{song.title}</strong><small>{song.album} · {song.year} · {stops[song.zone]?.name}</small></span>
              <span class="song-row__actions">
                <button class="song-row__open" type="button" data-open-song={song.id} aria-label={`打开《${song.title}》MV`} title={`打开《${song.title}》MV`}>▶</button>
                <button class="song-row__favorite" type="button" data-favorite-song={song.id} aria-label={`收藏《${song.title}》`} aria-pressed="false" title={`收藏《${song.title}》`}>☆</button>
                <a href={song.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`在${song.sourceLabel}打开《${song.title}》`} title={`在${song.sourceLabel}打开《${song.title}》`}>↗</a>
              </span>
            </li>
          ))}
        </ol>
        <p class="song-empty" id="song-empty" hidden>这里没有匹配的歌曲。</p>
      </aside>

      <dialog class="help-dialog" id="help-dialog" aria-labelledby="help-title">
        <div class="help-dialog__head"><span class="drawer-kicker">A LITTLE GUIDE</span><button class="panel-icon" id="help-close" type="button" aria-label="关闭帮助" title="关闭帮助">×</button></div>
        <h2 id="help-title">小镇漫游</h2>
        <p>沿五站路线走走，挑一首想听的歌。电脑上可用 WASD / 方向键行走，点击画面锁定鼠标转头（Esc 释放），也可拖动转头；手机上使用方向键。数字 1–5 或底部站名可瞬移到对应地点。</p>
        <p>MV 从原站嵌入。收起小窗会保留播放器，关闭则停止；能否播放由原站决定。</p>
        <div class="help-dialog__links"><a href="https://github.com/Kenton-GMI/sakura-crossing" target="_blank" rel="noopener noreferrer">3D 世界来源 Sakura Crossing ↗</a><a href="https://www.bilibili.com/video/BV1Ziac6JEUc/" target="_blank" rel="noopener noreferrer">视觉参考视频 ↗</a><a href="/">返回网站 ↗</a></div>
        <small>非官方歌迷作品。歌曲与影像版权归原权利人。小镇几何来自 Kenton-GMI/sakura-crossing（MIT），本站未附带其背景音乐。</small>
      </dialog>

      <noscript>
        <div class="nojs-catalog">
          <h2>周杰伦的樱花小镇</h2>
          <p>3D 小镇与站内播放器需要 JavaScript。仍可从原站打开歌曲：</p>
          <ol>{songs.map((song) => <li><a href={song.sourceUrl} target="_blank" rel="noopener noreferrer">{song.title} · {song.sourceLabel} ↗</a></li>)}</ol>
        </div>
      </noscript>
    </main>

    <script>
      /* `songs` is small and the drawer's search needs it immediately, so it
       * stays a static import.  The scene is the other 900 kB -- three.js and
       * sixty world modules -- and it is deliberately *not*: see `buildScene`
       * below, which pulls it in dynamically so the page and its loader paint
       * before a byte of it has parsed. */
      import { songs } from '../features/jay-town/songs'
      import type { mountTownScene as MountTownScene } from '../features/jay-town/scene'

      type Scene = ReturnType<typeof MountTownScene>
      type Song = (typeof songs)[number]
      const town = document.querySelector('#town') as HTMLElement
      const canvas = document.querySelector('#town-canvas') as HTMLCanvasElement
      const routeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-zone]')]
      const stationNames = ['樱花街口', '唱片小巷', '晴天广场', '花海车站', '七里香河堤']
      const stationMoods = ['把第一首歌，留给春天。', '旧唱片转动，晚风也有了节拍。', '阳光落在屋檐和路面之间。', '下一班列车，开往花开的地方。', '沿着水声，再听一遍夏天。']
      const sceneStatus = document.querySelector('#scene-status') as HTMLElement
      const sceneFailure = document.querySelector('#scene-failure') as HTMLElement
      const drawer = document.querySelector('#song-drawer') as HTMLElement
      const drawerOpen = document.querySelector('#song-drawer-open') as HTMLButtonElement
      const drawerClose = document.querySelector('#song-drawer-close') as HTMLButtonElement
      const search = document.querySelector('#song-search') as HTMLInputElement
      const zoneFilter = document.querySelector('#song-zone-filter') as HTMLSelectElement
      const favoritesFilter = document.querySelector('#favorites-filter') as HTMLButtonElement
      const songCount = document.querySelector('#song-count') as HTMLElement
      const songEmpty = document.querySelector('#song-empty') as HTMLElement
      const rows = [...document.querySelectorAll<HTMLElement>('[data-song-id]')]
      const favoriteKey = 'jay-town:favorites:v1'

      let currentZone = 0
      let currentSongId = songs[0]?.id ?? ''
      let openSongId = ''
      let night = false
      let favoriteOnly = false
      let favorites = new Set<string>()
      try {
        const saved = JSON.parse(localStorage.getItem(favoriteKey) || '[]')
        if (Array.isArray(saved)) favorites = new Set(saved.filter((value): value is string => typeof value === 'string'))
      } catch {}

      const findSong = (id: string): Song | undefined => songs.find((song) => song.id === id)
      const currentSong = (): Song | undefined => findSong(currentSongId)

      function updateZone(index: number) {
        if (!Number.isInteger(index) || index < 0 || index >= stationNames.length || currentZone === index) return
        currentZone = index
        ;(document.querySelector('#place-index') as HTMLElement).textContent = `${String(index + 1).padStart(2, '0')} / 05`
        ;(document.querySelector('#place-name') as HTMLElement).textContent = stationNames[index]
        ;(document.querySelector('#place-mood') as HTMLElement).textContent = stationMoods[index]
        routeButtons.forEach((button, buttonIndex) => {
          const active = buttonIndex === index
          button.classList.toggle('is-active', active)
          if (active) button.setAttribute('aria-current', 'location')
          else button.removeAttribute('aria-current')
        })
      }

      /* 缩略图条的高亮挂在 `onZone` 上而不是塞进 `updateZone`：站名是「地名」，
       * 缩略图是「素材」，两者只是恰好同属一站，分开写以后改任一边都不会
       * 牵着另一边走。`onZone` 要在挂载场景之前就存在，所以早读一次 DOM。 */
      const mediaButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-media-id]')]
      function markCurrentMedia(zone: number) {
        mediaButtons.forEach((button) => {
          button.classList.toggle('is-current', Number(button.dataset.mediaZone) === zone)
        })
      }
      function onZone(index: number) {
        updateZone(index)
        markCurrentMedia(index)
      }

      let scene: Scene | null = null

      /* --------------------------- loading the world ---------------------------
       *
       * The world build is synchronous and blocks for seconds, and on a phone
       * that is essentially the whole of the wait: there is no network left to
       * wait for and nothing to stream, it is one long frozen task.  A spinner
       * that never moves for thirty seconds is indistinguishable from a page
       * that has hung -- which is exactly what was reported.
       *
       * There is no honest progress bar to be had, because nothing can repaint
       * while the task runs: the first version of this tried to block inside
       * the build callback until the browser had painted, which cannot work --
       * it blocks the very paint it is waiting for.
       *
       * What does work is ordering.  The loader is already in the markup, so it
       * is painted with the rest of the page; then this sits on a couple of
       * animation frames so that paint is definitely *on screen* before the
       * build starts.  The labels that arrive during the build are collected
       * and shown on the failure panel if it never finishes, which is the one
       * case where knowing how far it got is worth anything. */
      const phaseEl = document.querySelector('#scene-phase') as HTMLElement
      const noteEl = document.querySelector('#scene-note') as HTMLElement
      const trailEl = document.querySelector('#scene-trail') as HTMLElement
      const phases: string[] = []

      const yieldFrame = () => new Promise<void>((resolve) => {
        requestAnimationFrame(() => requestAnimationFrame(() => resolve()))
      })

      function buildScene() {
        try {
          /* Dynamic on purpose.  A static import of this module puts three.js
           * and sixty world modules in the page's own chunk, so the browser has
           * to download and parse all of it before it can paint anything --
           * which is why thirty seconds of nothing used to be possible.  Here
           * the loader is already on screen by the time this runs. */
          return import('../features/jay-town/scene').then(({ mountTownScene }) => {
            scene = mountTownScene(canvas, {
            onPhase(label: string) {
              phases.push(label)
              phaseEl.textContent = label
              noteEl.textContent = `第 ${phases.length} 步，共 6 步`
              trailEl.textContent = '●'.repeat(phases.length) + '○'.repeat(Math.max(0, 6 - phases.length))
            },
            onReady() {
              /* The hand-off is a beat, not a switch.  `is-entering` fades the
               * poster and the loader out across the first half of the opening
               * dolly, so the street arrives *through* the wait rather than
               * replacing it -- and it is all CSS transitions, which keep
               * running on the compositor while the first frames are still the
               * most expensive ones the page will ever draw.
               *
               * Added on the *next* frame rather than here, and that matters:
               * this callback runs inside the same synchronous block as the
               * world build, so a class added now is never rendered -- the
               * animation would be attached to a state the browser never
               * painted, and would not run at all. */
              town.classList.add('scene-ready')
              town.classList.remove('scene-error')
              requestAnimationFrame(() => {
                town.classList.add('is-entering')
                window.setTimeout(() => town.classList.remove('is-entering'), 2600)
                /* Long enough for the dolly to land, short enough that the
                 * screen comes on while the viewer is still taking the town in.
                 * See the note on `autoPlayOnArrival`. */
                window.setTimeout(autoPlayOnArrival, 2800)
              })
              sceneStatus.hidden = true
              sceneFailure.hidden = true
            },
          onError() {
            town.classList.add('scene-error')
            town.classList.remove('scene-ready')
            sceneStatus.hidden = true
            sceneFailure.hidden = false
          },
          onZoneChange: onZone,
            })
          }).catch(failScene)
        } catch (error) {
          failScene(error)
        }
      }

      function failScene(error: unknown) {
        console.error('Unable to start sakura town', error)
        town.classList.add('scene-error')
        town.classList.remove('scene-ready')
        sceneStatus.hidden = true
        sceneFailure.hidden = false
        /* The one case where knowing how far it got is worth anything. */
        if (phases.length && !sceneFailure.querySelector('.scene-failure__where')) {
          const where = document.createElement('p')
          where.className = 'scene-failure__where'
          where.textContent = `停在：${phases[phases.length - 1]}（第 ${phases.length} 步）`
          sceneFailure.appendChild(where)
        }
      }

      /* ---------------------------- playing on arrival ---------------------------
       *
       * Asked for twice: walk in and the song is already playing on the town's
       * own screen, rather than waiting for a press.
       *
       * The delay is the trick and it is not cosmetic.  Browsers refuse audible
       * playback without a gesture, so an embed starts *muted* and takes a
       * second or two to boot; firing that at the same moment as the opening
       * dolly would put a loading player in the middle of the one shot the page
       * gets to make a first impression.  Waiting until the camera has settled
       * means the town is revealed clean, and then a screen a few metres away
       * lights up.
       *
       * It plays the song belonging to whichever stop the viewer is standing
       * at, so the thing that comes on is the thing in front of them. */
      function autoPlayOnArrival() {
        if (!songs.length) return
        /* Nothing to show it on means nothing to play: an audio-only start
         * would be a song coming out of an empty street. */
        if (!document.querySelector(`.media-portal[data-screen-zone="${currentZone}"]`)) return
        const opening = songs.find((song) => song.zone === currentZone) ?? songs[0]
        openSong(opening)
      }

      /* Let the loader be seen before the main thread is taken away. */
      void yieldFrame().then(buildScene)

      routeButtons.forEach((button) => button.addEventListener('click', () => {
        const index = Number(button.dataset.zone)
        if (!Number.isInteger(index)) return
        scene?.goTo(index)
      }))

      const dayButton = document.querySelector('#day-toggle') as HTMLButtonElement
      dayButton.addEventListener('click', () => {
        night = !night
        scene?.setNight(night)
        town.classList.toggle('is-night', night)
        dayButton.setAttribute('aria-pressed', String(night))
        dayButton.setAttribute('aria-label', night ? '切换到白天' : '切换到夜晚')
        dayButton.title = night ? '切换到白天' : '切换到夜晚'
        dayButton.firstElementChild!.textContent = night ? '☀' : '☾'
      })

      const help = document.querySelector('#help-dialog') as HTMLDialogElement
      const helpOpen = document.querySelector('#help-open') as HTMLButtonElement
      helpOpen.addEventListener('click', () => help.showModal())
      ;(document.querySelector('#help-close') as HTMLButtonElement).addEventListener('click', () => help.close())
      help.addEventListener('click', (event) => { if (event.target === help) help.close() })

      const restoreButton = document.querySelector('#ui-restore') as HTMLButtonElement
      ;(document.querySelector('#ui-hide') as HTMLButtonElement).addEventListener('click', () => {
        clearMovement()
        town.classList.add('ui-hidden')
        restoreButton.hidden = false
        restoreButton.focus()
      })
      restoreButton.addEventListener('click', () => {
        town.classList.remove('ui-hidden')
        restoreButton.hidden = true
        ;(document.querySelector('#ui-hide') as HTMLButtonElement).focus()
      })

      function setDrawer(open: boolean) {
        drawer.hidden = !open
        drawerOpen.setAttribute('aria-expanded', String(open))
        drawerOpen.classList.toggle('is-open', open)
        if (open) search.focus()
        else if (drawer.contains(document.activeElement)) drawerOpen.focus()
      }
      drawerOpen.addEventListener('click', () => setDrawer(drawer.hidden))
      drawerClose.addEventListener('click', () => setDrawer(false))
      ;(document.querySelector('#failure-songs') as HTMLButtonElement).addEventListener('click', () => setDrawer(true))

      /* The player bar is gone: it was the one piece of furniture laid over the
       * scene that also *repeated* what the screen already shows.  What is left
       * of its job is the drawer's own state and the row highlight. */
      function updatePlayer() {
        rows.forEach((row) => row.classList.toggle('is-current', row.dataset.songId === currentSongId))
        setStopVisible(openSongId !== '')
      }

      /* ------------------------- playing in the world -------------------------
       *
       * There is no video panel any more.  A song plays on the screen belonging
       * to *its* stop, inside the scene, and pressing play also walks the
       * viewer to that corner of the town -- because a screen you cannot see is
       * not a screen.  The iframe itself is owned by `screens/media-portal.ts`;
       * all this does is say which song, and where.
       */
      type Platform = 'bilibili' | 'youtube'
      let platform: Platform = 'bilibili'

      /** The page's half of the hub's contract: one song, one zone, one source. */
      function songForHub(song: Song) {
        return {
          zone: song.zone,
          id: song.id,
          title: song.title,
          embedUrl: song.embedUrl,
          youtubeEmbedUrl: song.youtubeEmbedUrl,
          sourceUrl: song.sourceUrl,
          sourceLabel: song.sourceLabel,
        }
      }

      function openSong(song: Song) {
        currentSongId = song.id
        openSongId = song.id
        scene?.setSong(songForHub(song))
        scene?.screens?.setPlatform(platform)
        scene?.focusScreen(song.zone)
        /* Take the viewer there: the screen is the destination, so the stop it
         * belongs to is where the walk should put them. */
        scene?.goTo(song.zone)
        updatePlayer()
        if (window.matchMedia('(max-width: 720px)').matches) setDrawer(false)
      }

      function closeVideo() {
        openSongId = ''
        scene?.setSong(null)
        updatePlayer()
      }

      /* ------------------------------- stop button ------------------------------
       *
       * Asked for plainly, and it was a fair ask: once the song starts on its own
       * there has to be a way to stop it that is not "walk twenty metres away".
       * Visible only while something is playing, and it is the one control that
       * appears without being asked for, so it stays small and out of the top
       * corner where the day/night and help buttons live. */
      const stopButton = document.querySelector('#stop-media') as HTMLButtonElement
      stopButton.addEventListener('click', () => {
        closeVideo()
        stopButton.hidden = true
        stopButton.blur()
      })

      function setStopVisible(visible: boolean): void {
        stopButton.hidden = !visible
      }

      function stepSong(direction: number) {
        if (!songs.length) return
        const index = Math.max(0, songs.findIndex((song) => song.id === currentSongId))
        openSong(songs[(index + direction + songs.length) % songs.length])
      }

      /* Bilibili's collection or YouTube's official upload.  It lives in the
       * drawer now, because the answer belongs to the song rather than to the
       * moment -- and it is worth having at all because the two are not
       * equivalent: the Bilibili collection is reachable from the mainland, the
       * YouTube uploads are the ones the rights holder actually posted. */
      const sourceButton = document.querySelector('#song-source') as HTMLButtonElement
      const sourceLabel = document.querySelector('#song-source-label') as HTMLElement
      sourceButton.addEventListener('click', () => {
        platform = platform === 'bilibili' ? 'youtube' : 'bilibili'
        sourceLabel.textContent = platform === 'bilibili' ? 'B站' : 'YouTube'
        scene?.screens?.setPlatform(platform)
        const text = `当前来源：${platform === 'bilibili' ? 'B站公开合集' : 'YouTube 官方 MV'}，点击切换`
        sourceButton.title = text
        sourceButton.setAttribute('aria-label', text)
      })

      function syncFavorites() {
        rows.forEach((row) => {
          const id = row.dataset.songId || ''
          const button = row.querySelector<HTMLButtonElement>('[data-favorite-song]')!
          const song = findSong(id)
          const active = favorites.has(id)
          button.setAttribute('aria-pressed', String(active))
          button.setAttribute('aria-label', `${active ? '取消收藏' : '收藏'}《${song?.title ?? ''}》`)
          button.title = button.getAttribute('aria-label') || ''
          button.textContent = active ? '★' : '☆'
        })
      }

      function filterSongs() {
        const query = search.value.trim().toLocaleLowerCase()
        const selectedZone = zoneFilter.value
        let visible = 0
        rows.forEach((row) => {
          const song = findSong(row.dataset.songId || '')
          if (!song) return
          const matches = (`${song.title} ${song.album} ${song.year}`).toLocaleLowerCase().includes(query)
            && (selectedZone === 'all' || String(song.zone) === selectedZone)
            && (!favoriteOnly || favorites.has(song.id))
          row.hidden = !matches
          if (matches) visible++
        })
        songCount.textContent = `${visible} / ${songs.length} 首歌曲`
        songEmpty.hidden = visible > 0
      }

      document.querySelector('#song-list')?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement
        const favorite = target.closest<HTMLButtonElement>('[data-favorite-song]')
        if (favorite) {
          const id = favorite.dataset.favoriteSong || ''
          if (favorites.has(id)) favorites.delete(id)
          else favorites.add(id)
          try { localStorage.setItem(favoriteKey, JSON.stringify([...favorites])) } catch {}
          syncFavorites()
          filterSongs()
          return
        }
        const open = target.closest<HTMLButtonElement>('[data-open-song]')
        if (open) {
          const song = findSong(open.dataset.openSong || '')
          if (song) openSong(song)
        }
      })
      search.addEventListener('input', filterSongs)
      zoneFilter.addEventListener('change', filterSongs)
      favoritesFilter.addEventListener('click', () => {
        favoriteOnly = !favoriteOnly
        favoritesFilter.setAttribute('aria-pressed', String(favoriteOnly))
        favoritesFilter.classList.toggle('is-active', favoriteOnly)
        filterSongs()
      })
      syncFavorites()
      filterSongs()
      updatePlayer()

      canvas.addEventListener('jay-town-open-song', ((event: CustomEvent<{ songId: string }>) => {
        const song = findSong(event.detail?.songId || '')
        if (song) openSong(song)
      }) as EventListener)

      /* ------------------------- 素材导航：表层那一半 -------------------------
       *
       * 缩略图是 Astro 在构建时按 `media.ts` 渲染的，这里只负责交互：
       * 点一下 → `scene.goTo(target)` 把镜头带到那一站；站内每块牌子上的
       * 命中盒走的是同一个 `goTo`（见 `crossing/world/jaymedia.js`）。
       *
       * 场景还没挂上时按钮也在（缩略图是静态渲染的），点下去只是没反应；
       * 所以这里等 `scene` 存在才真跳，并且不做假动画。 */
      const townNav = document.querySelector('#town-nav') as HTMLElement | null
      const townNavToggle = document.querySelector('#town-nav-toggle') as HTMLButtonElement | null

      function setNavOpen(open: boolean) {
        if (!townNav || !townNavToggle) return
        townNav.dataset.navOpen = String(open)
        townNavToggle.setAttribute('aria-expanded', String(open))
      }
      townNavToggle?.addEventListener('click', () => {
        setNavOpen(townNav?.dataset.navOpen !== 'true')
      })

      mediaButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = Number(button.dataset.mediaTarget)
          if (!Number.isInteger(target)) return
          scene?.goTo(target)
          markCurrentMedia(target)
          /* 手机上缩略图条铺满底部，选完自动收起，不然挡住路。 */
          if (window.matchMedia('(max-width: 720px)').matches) setNavOpen(false)
        })
      })

      /* 进来时先把第一站标上，免得缩略图条一开始谁都不高亮。 */
      markCurrentMedia(currentZone)

      const heldPointers = new Map<number, { x: number; z: number; button: HTMLButtonElement }>()
      function updateMovement() {
        let x = 0, z = 0
        heldPointers.forEach((direction) => { x += direction.x; z += direction.z })
        scene?.setMove(Math.sign(x), Math.sign(z))
      }
      function clearMovement() {
        heldPointers.forEach((direction) => direction.button.classList.remove('is-pressed'))
        heldPointers.clear()
        scene?.setMove(0, 0)
      }
      document.querySelectorAll<HTMLButtonElement>('[data-move-x]').forEach((button) => {
        button.addEventListener('pointerdown', (event) => {
          event.preventDefault()
          button.setPointerCapture(event.pointerId)
          heldPointers.set(event.pointerId, { x: Number(button.dataset.moveX), z: Number(button.dataset.moveZ), button })
          button.classList.add('is-pressed')
          updateMovement()
        })
        button.addEventListener('pointerup', (event) => {
          heldPointers.delete(event.pointerId)
          button.classList.remove('is-pressed')
          updateMovement()
        })
        button.addEventListener('pointercancel', clearMovement)
        button.addEventListener('lostpointercapture', (event) => {
          if (heldPointers.has(event.pointerId)) clearMovement()
        })
      })
      window.addEventListener('blur', clearMovement)
      document.addEventListener('visibilitychange', () => { if (document.hidden) clearMovement() })
      window.addEventListener('pagehide', (event) => {
        clearMovement()
        if (!event.persisted) { closeVideo(); scene?.dispose() }
      })
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return
        if (!help.open && !drawer.hidden) setDrawer(false)
      })
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; --ink: #1f3837; --cream: #f8f5ec; --pink: #e8a2ad; --pink-deep: #ac596c; --teal: #255956; --line: #d7dfd8; --sans: 'PingFang SC', 'Microsoft YaHei', sans-serif; --serif: 'Noto Serif CJK SC', 'Songti SC', SimSun, serif; }
  * { box-sizing: border-box; }
  html, body { min-width: 320px; min-height: 100%; margin: 0; }
  body { font-family: var(--sans); letter-spacing: 0; background: #dcece7; color: var(--ink); }
  button, input, select { font: inherit; letter-spacing: 0; }
  button { cursor: pointer; }
  button:disabled { opacity: .4; cursor: default; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid #a44460; outline-offset: 3px; }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip-link { position: fixed; z-index: 80; left: 12px; top: 12px; padding: 9px 12px; background: var(--cream); color: var(--ink); transform: translateY(-160%); }
  .skip-link:focus { transform: none; }

  .town { position: fixed; inset: 0; isolation: isolate; overflow: hidden; background: #dcece7; }
  .town-poster, .town-canvas, .town-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .town-poster { z-index: -3; background: linear-gradient(145deg, #b9dbe9, #f1dbe0 64%, #698785); }
  .scene-error .town-poster { background: #b9dbe9 url('/jay-town/scene-poster.webp') center / cover no-repeat; }
  .town-canvas { display: block; z-index: -2; opacity: 0; touch-action: none; cursor: grab; }
  .town-canvas.is-dragging { cursor: grabbing; }
  /* The reveal.  The canvas comes up over the poster, and a sheet of warm haze
   * lifts off the top of the frame -- like the opening frame of an anime
   * coming up out of white.  Both are opacity/transform only, so the compositor
   * carries them while the first frames are still being paid for. */
  .scene-ready .town-canvas { opacity: 1; transition: opacity 1.5s ease-out .2s; }
  .town-poster { transition: opacity 1.6s ease-out; }
  .scene-ready .town-poster { opacity: 0; }
  .town-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(180deg, #fdf6f0 0%, #f3e7ea 42%, #e9eef0 100%);
    opacity: 0;
  }
  .is-entering .town-veil { animation: town-veil-lift 2.3s cubic-bezier(.22, .7, .2, 1) forwards; }
  @keyframes town-veil-lift {
    0% { opacity: .94; transform: translateY(0) scale(1.06); }
    55% { opacity: .38; transform: translateY(-3%) scale(1.02); }
    100% { opacity: 0; transform: translateY(-9%) scale(1); }
  }
  .scene-error .town-veil { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .scene-ready .town-canvas, .town-poster { transition: none; }
    .is-entering .town-veil { animation: none; }
  }
  .town-shade { z-index: -1; pointer-events: none; background: linear-gradient(180deg, rgba(22, 52, 53, .27) 0%, transparent 27%, transparent 59%, rgba(20, 49, 47, .3) 100%); }
  .town.is-night .town-shade { background: linear-gradient(180deg, rgba(8, 20, 30, .53), transparent 30%, transparent 48%, rgba(7, 20, 30, .54)); }

  /* ---------------------------- in-world screens ----------------------------
     Each screen is a real object in the scene.  The page's job is only to hold
     the player's picture on top of it: `.screen-layer` is the viewport-sized
     frame the projection is measured against, and `.media-portal` is one
     player, pinned to its screen by a `matrix3d` written every frame.

     `transform-origin: 0 0` is not a style choice -- the projection solves for
     the element's top-left corner, and any other origin shifts the whole quad.
     `backface-visibility: hidden` and the browser prefixes on the mask are the
     two other things this depends on; see `screens/projection.ts`. */
  .screen-layer { position: absolute; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
  .media-portal {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    /* the frame's aspect, which must match the 3D screen's */
    aspect-ratio: 16 / 9;
    transform-origin: 0 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    opacity: 0;
    pointer-events: none;
    background: #1c2230;
  }
  .media-portal.is-live { opacity: 1; pointer-events: auto; }
  /* The scar of the occlusion mask: the same mask, painted dark, so the video's
     cut edge reads as an unlit screen and not as a hole in the geometry. */
  .media-portal__veil {
    position: absolute;
    inset: -1px;
    background: radial-gradient(120% 120% at 50% 45%, #10151f 0%, #05070c 100%);
    pointer-events: none;
  }
  .media-portal__stage { position: absolute; inset: 0; overflow: hidden; }
  .media-portal__frame { display: block; width: 100%; height: 100%; border: 0; }
  .media-portal__badge {
    position: absolute;
    left: 0;
    bottom: -22px;
    padding: 3px 7px;
    background: #f8f5ecdd;
    color: #2b4140;
    font: 600 10px/1.3 var(--sans);
    letter-spacing: .02em;
    white-space: nowrap;
    opacity: 0;
    transition: opacity .25s ease;
  }
  .media-portal.is-live .media-portal__badge { opacity: 1; }
  .ui-hidden .screen-layer { display: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .media-portal__badge { transition: none; }
  }

  .town-header { position: absolute; z-index: 4; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; padding: max(24px, env(safe-area-inset-top)) max(26px, env(safe-area-inset-right)) 0 max(26px, env(safe-area-inset-left)); color: #fcfcf7; text-shadow: 0 2px 10px #1633318c; }
  .identity { max-width: 380px; }
  .identity__labels { display: flex; gap: 9px; margin-bottom: 13px; font: 700 10px/1 var(--sans); color: #fff8e8; }
  .identity__labels span { padding: 6px 8px 5px; border: 1px solid #fff8e8a8; background: #22423b61; }
  .identity__labels span:first-child { background: #f0a9b4e8; border-color: #f0a9b4; color: #173c3c; text-shadow: none; }
  .identity h1 { margin: 0; font: 500 30px/1.25 var(--serif); text-shadow: 0 2px 16px #12342fc2; }
  .identity h1 span { display: block; margin-top: 2px; font-size: 34px; font-weight: 700; }
  .identity p { margin: 10px 0 0; font: 12px/1.55 var(--serif); }
  .header-tools { display: flex; align-items: center; gap: 8px; }
  .home-link, .tool-button, .hide-button { display: inline-flex; align-items: center; justify-content: center; min-height: 37px; border: 1px solid #f8f5ecb8; background: #173c3e7a; color: #fffdf6; text-decoration: none; text-shadow: none; backdrop-filter: blur(10px); }
  .home-link { gap: 6px; padding: 0 11px; font-size: 12px; }
  .tool-button { width: 37px; padding: 0; font-size: 19px; line-height: 1; }
  .tool-button.day-toggle { font-size: 21px; }
  .hide-button { padding: 0 11px; font-size: 11px; }
  .home-link:hover, .tool-button:hover, .hide-button:hover { background: #1f5757cc; }
  .ui-restore { position: absolute; z-index: 30; right: max(20px, env(safe-area-inset-right)); top: max(20px, env(safe-area-inset-top)); padding: 9px 12px; border: 1px solid #f8f5ecb8; background: #173c3eaa; color: #fff; backdrop-filter: blur(8px); }
  .ui-hidden .town-header, .ui-hidden .town-route, .ui-hidden .place-stamp, .ui-hidden .drawer-handle, .ui-hidden .move-pad, .ui-hidden .song-drawer, .ui-hidden .video-panel, .ui-hidden .scene-status, .ui-hidden .scene-failure { display: none !important; }

  /* ----------------------------- loading state -----------------------------
     The main thread is blocked for the whole world build, so *nothing* driven
     by script can animate here.  Anything that has to keep moving while the
     scene is being built must be a CSS animation, which the compositor keeps
     running on its own thread -- hence the spinner being three plain spans and
     a keyframe rather than anything the page updates. */
  .scene-status {
    position: absolute;
    z-index: 3;
    /* **Anchored to the top, not centred.**
     *
     * This was `top: 50%` with a `translate(-50%, -50%)`, and on a phone it
     * landed off the left edge with its text under the header: a percentage
     * `top` resolves against the containing block, and inside a `position:
     * fixed` parent with a transformed child the box is not the viewport you
     * think it is.  Anchoring from the top with `translateX` only removes every
     * one of those dependencies. */
    left: 50%;
    top: max(112px, 14vh);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 15px;
    width: min(340px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
    padding: 15px 18px;
    border: 1px solid #ffffff2e;
    border-radius: 10px;
    background: #16302ed9;
    color: #f8f5ec;
    box-shadow: 0 18px 54px #0b211f59;
    backdrop-filter: blur(14px);
  }
  .scene-status__body { display: grid; gap: 4px; min-width: 0; }
  .scene-status__body strong { font: 600 15px/1.35 var(--serif); letter-spacing: .01em; }
  .scene-status__body span { color: #cfe0d8; font-size: 11px; line-height: 1.45; }
  .scene-status__trail { position: absolute; left: 18px; bottom: 6px; color: #ed9caa; font-size: 6px; letter-spacing: 2px; }
  /* Three petals on a short orbit, in the page's own blossom pink. */
  .scene-status__mark { position: relative; flex: none; width: 30px; height: 30px; animation: town-spin 2.4s linear infinite; }
  .scene-status__mark i {
    position: absolute; width: 9px; height: 9px; border-radius: 50%;
    background: #f0a9b4;
  }
  .scene-status__mark i:nth-child(1) { left: 10px; top: 0; }
  .scene-status__mark i:nth-child(2) { left: 1.5px; bottom: 3px; opacity: .72; }
  .scene-status__mark i:nth-child(3) { right: 1.5px; bottom: 3px; opacity: .45; }
  @keyframes town-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .scene-status__mark { animation: none; } }
  .scene-failure__where { margin: 7px 0 0; color: #6c8179; font-size: 11px; }

  .scene-failure { position: absolute; z-index: 3; left: max(26px, env(safe-area-inset-left)); top: 178px; max-width: 235px; padding: 12px 14px; background: #f8f5ecee; color: var(--ink); font-size: 12px; line-height: 1.6; }
  .scene-failure p { margin: 0 0 9px; }
  .scene-failure__action { padding: 4px 0; border: 0; border-bottom: 1px solid var(--pink-deep); background: none; color: var(--pink-deep); }
  .place-stamp { position: absolute; z-index: 2; right: max(28px, env(safe-area-inset-right)); bottom: 30px; display: grid; gap: 4px; color: #fffdf6; text-align: right; text-shadow: 0 2px 12px #0c322ab0; }
  .place-stamp__index { font-size: 10px; font-weight: 700; }
  .place-stamp strong { font: 600 18px/1.3 var(--serif); }
  .place-stamp span:last-child { font: 11px/1.4 var(--serif); }

  .town-route { position: absolute; z-index: 5; left: 50%; bottom: max(27px, env(safe-area-inset-bottom)); width: min(610px, calc(100% - 610px)); min-width: 475px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid #fffdf6b8; transform: translateX(-50%); }
  .town-route__stop { position: relative; display: grid; align-content: start; justify-items: start; gap: 4px; min-width: 0; min-height: 56px; padding: 12px 2px 2px 0; border: 0; background: none; color: #fffdf6c9; text-align: left; text-shadow: 0 2px 8px #193f39ad; }
  .town-route__marker { position: absolute; top: -4px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: #f8f5ecb0; }
  .town-route__number { font: 700 10px/1 var(--sans); }
  .town-route__stop strong { overflow: hidden; max-width: 100%; font: 600 13px/1.25 var(--serif); white-space: nowrap; text-overflow: ellipsis; }
  .town-route__stop:hover, .town-route__stop.is-active { color: #fff; }
  .town-route__stop.is-active .town-route__marker { background: #ed9caa; box-shadow: 0 0 0 4px #ed9caa45, 0 0 12px #fff; }

  /* The song-list handle.  The player bar is gone: it was the one piece of
     furniture laid over the scene that also *repeated* what the screen already
     shows -- the song title, the transport, the credits -- and with the MV now
     starting on its own there was nothing left for it to do that the town was
     not already doing.  This is all that survives, and it earns its place by
     being a way *in* to the list rather than a readout of it. */
  .drawer-handle { position: absolute; z-index: 6; left: max(25px, env(safe-area-inset-left)); bottom: max(28px, env(safe-area-inset-bottom)); display: grid; gap: 4px; justify-items: center; padding: 7px 13px 6px; border: 1px solid #fffdf6c4; border-radius: 8px; background: #f8f5ece8; color: var(--ink); box-shadow: 0 6px 20px #153c372e; backdrop-filter: blur(12px); }
  .drawer-handle__bar { width: 22px; height: 2px; border-radius: 2px; background: #9db0a7; }
  .drawer-handle__label { color: #4c7067; font-size: 10px; letter-spacing: .04em; white-space: nowrap; }
  .drawer-handle__label b { color: var(--teal); font-weight: 700; }
  .drawer-handle:hover, .drawer-handle.is-open { background: #fffdf6; border-color: var(--pink); }
  .drawer-handle:hover .drawer-handle__bar, .drawer-handle.is-open .drawer-handle__bar { background: var(--pink-deep); }

  /* Stops whatever is playing on a screen.  Deliberately one of the smallest
     things on the page: it appears on its own the moment a song starts, and a
     control nobody asked for should not compete with the town. */
  .stop-media {
    position: absolute;
    z-index: 8;
    right: max(26px, env(safe-area-inset-right));
    top: max(86px, calc(env(safe-area-inset-top) + 86px));
    display: inline-flex;
    align-items: center;
